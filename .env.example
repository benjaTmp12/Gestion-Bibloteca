PORT=3000
# ID del proyecto Firebase en plan Spark. No contiene credenciales.
FIREBASE_PROJECT_ID=demo-biblioteca
# Solo para desarrollo con el emulador local; quitar esta variable en la VM.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# En la VM: ruta a la cuenta de servicio fuera de public/ y de Git.
# GOOGLE_APPLICATION_CREDENTIALS=C:/ruta-privada/cuenta-servicio.json
